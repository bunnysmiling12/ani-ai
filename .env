# Ani.ai Content Creator - Demo Configuration
# This file contains demo values for immediate testing

# OpenAI Configuration (Demo mode - will use fallback scripts)
OPENAI_API_KEY=demo-key-for-testing

# Social Media Platform Configurations (Demo mode)
INSTAGRAM_USERNAME=demo_user
INSTAGRAM_PASSWORD=demo_password
YOUTUBE_API_KEY=demo_youtube_key
TWITTER_API_KEY=demo_twitter_key
TWITTER_API_SECRET=demo_twitter_secret
TWITTER_ACCESS_TOKEN=demo_access_token
TWITTER_ACCESS_SECRET=demo_access_secret

# Server Configuration
PORT=3000
NODE_ENV=development

# Content Generation Settings
DEFAULT_CATEGORY=motivation
GENERATION_FREQUENCY=6
AUTO_POST_ENABLED=true

# Demo Settings
DEMO_MODE=true