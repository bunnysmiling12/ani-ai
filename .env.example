# Ani.ai Content Creator - Environment Configuration

# OpenAI Configuration (Required for AI script generation)
OPENAI_API_KEY=your_openai_api_key

# Social Media Platform Configurations

# Instagram (Required for Instagram posting)
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# YouTube (Required for YouTube posting)
YOUTUBE_API_KEY=your_youtube_api_key

# Twitter/X (Required for Twitter posting)
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret

# Facebook (Optional - for Facebook posting)
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token

# TikTok (Optional - requires special approval)
TIKTOK_API_KEY=your_tiktok_api_key

# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (SQLite is used by default)
DB_PATH=./ani_ai.db

# Content Generation Settings
DEFAULT_CATEGORY=motivation
GENERATION_FREQUENCY=6
AUTO_POST_ENABLED=true

# Security Settings
SESSION_SECRET=your_secure_session_secret

# File Upload Settings
MAX_FILE_SIZE=50MB
UPLOAD_PATH=./uploads/

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./combined.log